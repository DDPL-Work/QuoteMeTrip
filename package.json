{
  "name": "troublefree-holiday",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "web/apps/*",
    "web/packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
