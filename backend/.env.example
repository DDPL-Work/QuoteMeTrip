NODE_ENV=development
PORT=50011

WEB_TRAVELLER_URL=http://localhost:5173
WEB_AGENCY_URL=http://localhost:5174
WEB_ADMIN_URL=http://localhost:5175

# --- MySQL + Sequelize (Phase 2) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=troublefree_holiday
DB_USER=root 
DB_DIALECT=mysql

# Connection pool tuning
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_CONNECT_TIMEOUT_MS=10000

# Set to 'true' to print SQL statements (development debugging only)
DB_LOGGING=false

# 'true' = refuse to boot without a live database (default in production).
# 'false' = boot degraded and report via /api/v1/health (default locally).
# DB_REQUIRE_ON_BOOT=false

# Isolated database used when NODE_ENV=test (never destructive on dev)
DB_TEST_NAME=troublefree_holiday_test

# --- Authentication (Phase 3) ---
# Generate strong secrets locally; inject via secure config in production.
# Never commit real secrets.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

AUTH_BCRYPT_ROUNDS=12
AUTH_PASSWORD_MIN_LENGTH=8

AUTH_COOKIE_NAME=tfh_refresh
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SAME_SITE=lax
# 'true' in production (HTTPS). 'false' for plain-HTTP local development.
AUTH_COOKIE_SECURE=false

# Login/refresh rate limiting (per IP, per 15 minutes by default)
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=100

# Agency registration email policy: 'open' (default) or 'corporate'
# ('corporate' rejects well-known free providers)
AGENCY_EMAIL_POLICY=open

# Google login (Traveller only). Empty = Google login unavailable.
GOOGLE_CLIENT_ID=

# Admin provisioning (used by `npm run admin:create` only — never commit)
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# --- Traveller core: route planning (Phase 4) ---
# Map provider selection: 'haversine' (default, credential-free
# great-circle fallback) or 'osrm'. Any other value returns a clear
# 503 MAP_PROVIDER_NOT_CONFIGURED at call time — the rest of the app
# keeps working.
MAP_PROVIDER=haversine

# Required only when MAP_PROVIDER=osrm.
# MAP_OSRM_BASE_URL=

# --- Weather boundary (Phase 4) ---
# Empty = weather degrades gracefully ({ available: false }); request
# creation never depends on weather availability.
# WEATHER_API_KEY=
