NODE_ENV=development
PORT=5000

WEB_TRAVELLER_URL=http://localhost:5173
WEB_AGENCY_URL=http://localhost:5174
WEB_ADMIN_URL=http://localhost:5175

# --- MySQL + Sequelize (Phase 2) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=troublefree_holiday
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# Connection pool tuning
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_CONNECT_TIMEOUT_MS=10000

# Set to 'true' to print SQL statements (development debugging only)
DB_LOGGING=false

# 'true' = refuse to boot without a live database (default in production).
# 'false' = boot degraded and report via /api/v1/health (default locally).
# DB_REQUIRE_ON_BOOT=false

# Isolated database used when NODE_ENV=test (never destructive on dev)
DB_TEST_NAME=troublefree_holiday_test
